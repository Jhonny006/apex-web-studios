---
import "../styles/global.css";
import { getDict, defaultLocale } from "../i18n";

// Props del layout: cada página puede pasar su propio título y descripción.
// Los valores por defecto salen del diccionario del idioma activo.
interface Props {
	title?: string;
	description?: string;
}

const locale = Astro.currentLocale ?? defaultLocale;
const t = getDict(locale);

const { title = t.meta.title, description = t.meta.description } = Astro.props;

// hreflang: le dice a Google que estas URLs son la misma página en
// distintos idiomas. x-default = a quién mandar si no hay match.
const enUrl = new URL("/", Astro.site);
const esUrl = new URL("/es/", Astro.site);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Fuentes: preconnect abre la conexión antes de pedir el CSS -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,300..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
