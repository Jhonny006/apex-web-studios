---
// Ruta: src/layouts/Layout.astro
import "../styles/global.css"; // <--- Vincula tus tokens oficiales de Tailwind v4
import { getDict, defaultLocale } from "../i18n";

interface Props {
	title?: string;
	description?: string;
}

const locale = Astro.currentLocale ?? defaultLocale;
const t = getDict(locale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const enUrl = new URL("/", Astro.site);
const esUrl = new URL("/es/", Astro.site);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta name="google" content="notranslate" />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Fuentes oficiales de Apex Web Studios corregidas -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,300..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-night text-ink font-body antialiased">
		<slot />

		<script>
			document.documentElement.classList.add("js");
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("revealed");
							observer.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: "0px 0px -80px 0px" },
			);
			document
				.querySelectorAll("[data-reveal]")
				.forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
