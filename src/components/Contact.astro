---
import { getDict } from "../i18n";
import SectionHeading from "./ui/SectionHeading.astro";

const t = getDict(Astro.currentLocale);

// Clases compartidas de los campos: un solo lugar para ajustar el estilo.
// Nota: NUNCA quitar el outline de focus sin dar un reemplazo visible —
// aquí el reemplazo es el borde lima.
const fieldClass =
	"w-full border border-line bg-transparent px-4 py-3 text-sm text-ink placeholder:text-ink-muted/50 transition-colors focus:border-accent focus:outline-none";
const labelClass =
	"mb-2 block font-mono text-[10px] uppercase tracking-[0.2em] text-ink-muted";
---

<section id="contact" class="scroll-mt-24 border-b border-line">
	<div
		class="mx-auto grid max-w-7xl grid-cols-1 gap-14 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:gap-20"
		data-reveal
	>
		<!-- Columna izquierda: título, blurb, datos y redes -->
		<div>
			<SectionHeading label={t.contact.label} title={t.contact.title} />

			<p class="mt-8 max-w-md text-sm leading-relaxed text-ink-muted">
				{t.contact.blurb}
			</p>

			<dl class="mt-10 space-y-6">
				<div>
					<dt class={labelClass}>{t.contact.infoLabels.email}</dt>
					<dd>
						<a
							href={`mailto:${t.contact.email}`}
							class="text-sm text-ink transition-colors hover:text-accent"
						>
							{t.contact.email}
						</a>
					</dd>
				</div>
				<div>
					<dt class={labelClass}>{t.contact.infoLabels.phone}</dt>
					<dd>
						<a
							href={`tel:${t.contact.phone.replace(/[^+\d]/g, "")}`}
							class="text-sm text-ink transition-colors hover:text-accent"
						>
							{t.contact.phone}
						</a>
					</dd>
				</div>
				<div>
					<dt class={labelClass}>{t.contact.infoLabels.address}</dt>
					<dd class="text-sm text-ink">{t.contact.address}</dd>
				</div>
			</dl>

			<div class="mt-10 flex flex-wrap gap-x-5 gap-y-2">
				{
					t.contact.socials.map((social) => (
						<a
							href="#"
							class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-muted transition-colors hover:text-accent"
						>
							{social}
						</a>
					))
				}
			</div>
		</div>

		<!-- Columna derecha: formulario. Sin backend todavía — el atributo
		     action se conectará a un servicio (Formspree/Resend) o a una
		     Astro Action cuando toque. -->
		<form class="space-y-6" novalidate>
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
				<div>
					<label for="first-name" class={labelClass}>
						{t.contact.form.firstName}
					</label>
					<input
						id="first-name"
						name="firstName"
						type="text"
						autocomplete="given-name"
						required
						class={fieldClass}
					/>
				</div>
				<div>
					<label for="last-name" class={labelClass}>
						{t.contact.form.lastName}
					</label>
					<input
						id="last-name"
						name="lastName"
						type="text"
						autocomplete="family-name"
						required
						class={fieldClass}
					/>
				</div>
			</div>

			<div>
				<label for="email" class={labelClass}>{t.contact.form.email}</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					class={fieldClass}
				/>
			</div>

			<div>
				<label for="project-type" class={labelClass}>
					{t.contact.form.projectType}
				</label>
				<select id="project-type" name="projectType" required class={fieldClass}>
					<option value="" selected disabled>{t.contact.form.selectOne}</option>
					{
						t.contact.form.projectTypes.map((type) => (
							<option value={type}>{type}</option>
						))
					}
				</select>
			</div>

			<div>
				<label for="message" class={labelClass}>{t.contact.form.message}</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					class={`${fieldClass} resize-y`}></textarea>
			</div>

			<button
				type="submit"
				class="group w-full bg-accent py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-night transition-colors hover:bg-ink"
			>
				{t.contact.form.submit}
				<span
					class="inline-block transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
				>
					&nearr;
				</span>
			</button>
		</form>
	</div>
</section>

<style>
	/* Los <option> nativos ignoran el CSS del select en varios SO:
	   forzamos fondo oscuro para que el desplegable no salga blanco */
	option {
		background-color: var(--color-night);
		color: var(--color-ink);
	}
</style>
