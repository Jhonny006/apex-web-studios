---
import { getDict } from "../i18n";

const t = getDict(Astro.currentLocale);
---

<section class="relative border-b border-line">
	<div class="mx-auto max-w-7xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
		<!-- Fila superior: tag de marca + metadato de estudio -->
		<div class="flex items-start justify-between">
			<p
				class="anim font-mono text-xs uppercase tracking-[0.2em] text-accent"
				style="--d: 0ms"
			>
				<span class="mr-3 inline-block h-px w-8 bg-accent align-middle"></span>
				{t.hero.tag}
			</p>
			<p
				class="anim hidden text-right font-mono text-xs uppercase leading-relaxed tracking-[0.2em] text-ink-muted sm:block"
				style="--d: 100ms"
			>
				{t.hero.est}<br />{t.hero.location}
			</p>
		</div>

		<!-- Titular: Chakra Petch 700 (cuadrada/técnica) + clamp() fluido -->
		<h1
			class="mt-10 font-headline text-[clamp(2.9rem,10.5vw,6rem)] font-bold uppercase leading-[0.95]"
		>
			{
				t.hero.lines.map((line, i) => (
					<span
						class={`anim block ${i === 1 ? "text-accent" : ""}`}
						style={`--d: ${150 + i * 110}ms`}
					>
						{line}
					</span>
				))
			}
		</h1>

		<!-- Fila inferior: propuesta de valor + CTAs -->
		<div
			class="mt-12 flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between"
		>
			<p
				class="anim max-w-md leading-relaxed text-ink-muted"
				style="--d: 480ms"
			>
				{t.hero.paragraph}
			</p>

			<!-- Indicador SCROLL: elemento EN FLUJO entre párrafo y CTAs (como en
			     la referencia) — así jamás se monta sobre otro contenido. Solo
			     visible desde lg y en el tope de la página (JS le baja opacidad). -->
			<div
				id="scroll-hint"
				class="pointer-events-none hidden flex-col items-center gap-3 self-end transition-opacity duration-500 lg:flex"
			>
				<span
					class="font-mono text-[10px] uppercase tracking-[0.35em] text-ink-muted"
				>
					{t.hero.scroll}
				</span>
				<span class="relative block h-14 w-px bg-line">
					<span
						class="hint-stretch absolute left-0 top-0 block h-full w-px bg-accent"
					></span>
				</span>
			</div>

			<div class="anim flex items-center gap-7" style="--d: 580ms">
				<a
					href="#work"
					class="group font-mono text-xs uppercase tracking-[0.18em] text-ink transition-colors hover:text-accent"
				>
					{t.hero.viewWork}
					<span
						class="inline-block transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					>
						&nearr;
					</span>
				</a>
				<a
					href="#contact"
					class="bg-accent px-5 py-3 font-mono text-xs font-bold uppercase tracking-[0.18em] text-night transition-colors hover:bg-ink"
				>
					{t.hero.cta}
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	/* Coreografía de entrada: misma animación, delay distinto por elemento.
	   forwards = conserva el estado final (opacity 1) al terminar. */
	.anim {
		opacity: 0;
		animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: var(--d, 0ms);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* Segmento lima del indicador SCROLL: anclado arriba, se estira
	   hacia abajo y se contrae (alternate = ida y vuelta), en bucle. */
	.hint-stretch {
		transform-origin: top; /* el estiramiento crece desde el borde superior */
		animation: stretch 1.3s ease-in-out infinite alternate;
	}

	@keyframes stretch {
		from {
			transform: scaleY(0.25);
		}
		to {
			transform: scaleY(0.85);
		}
	}

	/* Si el usuario pidió menos movimiento en su SO, se lo respetamos */
	@media (prefers-reduced-motion: reduce) {
		.anim {
			animation: none;
			opacity: 1;
		}
		.hint-stretch {
			animation: none;
			transform: scaleY(0.4);
		}
	}
</style>

<script>
	// Visibilidad del indicador SCROLL: solo en el tope de la página.
	const hint = document.getElementById("scroll-hint");

	if (hint) {
		const update = () => {
			hint.classList.toggle("opacity-0", window.scrollY > 40);
		};
		update(); // estado correcto también si la página carga ya scrolleada
		window.addEventListener("scroll", update, { passive: true });
	}
</script>
