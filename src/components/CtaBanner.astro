---
import { getDict } from "../i18n";

const t = getDict(Astro.currentLocale);
---

<!-- Sección "breakout": colores invertidos (lima de fondo, tinta oscura).
     Tras 6 secciones oscuras, el golpe de color reactiva la atención
     justo antes del formulario de contacto. -->
<section class="bg-accent">
	<div
		class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-8 sm:py-24 lg:flex-row lg:items-center lg:justify-between"
		data-reveal
	>
		<h2
			class="max-w-3xl font-headline text-[clamp(2rem,5.5vw,4rem)] font-bold uppercase leading-[1.02] text-night"
		>
			{t.ctaBand.title}
		</h2>
		<a
			href="#contact"
			class="group self-start whitespace-nowrap bg-night px-7 py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-ink transition-colors hover:text-accent lg:self-auto"
		>
			{t.ctaBand.cta}
			<span
				class="inline-block transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
			>
				&nearr;
			</span>
		</a>
	</div>
</section>
