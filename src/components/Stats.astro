---
import { getDict } from "../i18n";

const t = getDict(Astro.currentLocale);
---

<section class="border-b border-line">
	<div class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-16" data-reveal>
		<!-- Truco "hairline grid": fondo gris + gap de 1px + celdas oscuras
		     = divisorias de 1px en ambos ejes sin gestionar bordes por celda -->
		<div
			class="grid grid-cols-2 gap-px border border-line bg-line lg:grid-cols-4"
		>
			{
				t.stats.map((stat) => (
					<div class="bg-night p-7 sm:p-9">
						<p class="font-headline text-4xl font-bold text-accent sm:text-5xl">
							{stat.value}
						</p>
						<p class="mt-3 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-muted">
							{stat.label}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>
