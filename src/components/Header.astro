---
import { getDict } from "../i18n";
import LangSwitch from "./ui/LangSwitch.astro";

// El diccionario del idioma activo: todos los textos salen de aquí.
const t = getDict(Astro.currentLocale);
---

<!-- sticky siempre. Dos estados: transparente en el tope de la página,
     oscuro + blur al hacer scroll (el JS alterna las clases). -->
<header id="site-header" class="sticky top-0 z-50 transition-colors duration-300">
	<div
		class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8"
	>
		<a
			href="/"
			class="font-bold text-sm uppercase tracking-[0.25em] hover:text-accent transition-colors"
		>
			Apex Web Studios
		</a>

		<!-- Nav desktop: oculta en mobile (hidden), visible desde md (768px) -->
		<nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
			{
				t.nav.links.map((link) => (
					<a
						href={link.href}
						class="font-mono text-xs uppercase tracking-[0.18em] text-ink-muted transition-colors hover:text-accent"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="hidden items-center gap-6 md:flex">
			<LangSwitch />
			<a
				href="#contact"
				class="bg-accent px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.18em] text-night transition-colors hover:bg-ink"
			>
				{t.nav.cta}
			</a>
		</div>

		<!-- Hamburguesa: solo visible en mobile (md:hidden) -->
		<button
			id="menu-open"
			type="button"
			class="p-2 text-ink transition-colors hover:text-accent md:hidden"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<svg
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<line x1="3" y1="7" x2="21" y2="7"></line>
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="17" x2="21" y2="17"></line>
			</svg>
		</button>
	</div>

	<!-- Línea inferior del navbar: invisible en el tope, aparece con el scroll.
	     El destello (span interior) barre una sola vez en el primer scroll. -->
	<div
		id="nav-line"
		class="relative h-px w-full overflow-hidden bg-line opacity-0 transition-opacity duration-300"
	>
		<span
			id="nav-flash"
			class="block h-full w-1/3 -translate-x-full bg-gradient-to-r from-transparent via-accent to-transparent"
		></span>
	</div>
</header>

<!-- Overlay móvil a pantalla completa: h-dvh cubre el viewport real
     (100vh clásico falla con la barra de URL de los navegadores móviles) -->
<div
	id="mobile-menu"
	class="fixed inset-0 z-[70] hidden h-dvh w-full flex-col overflow-y-auto bg-night px-5 py-4 md:hidden"
>
	<div class="flex items-center justify-between border-b border-line pb-4">
		<span class="font-bold text-sm uppercase tracking-[0.25em]">
			Apex Web Studios
		</span>
		<button
			id="menu-close"
			type="button"
			class="p-2 text-ink transition-colors hover:text-accent"
			aria-label="Close menu"
		>
			<svg
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
			>
				<line x1="5" y1="5" x2="19" y2="19"></line>
				<line x1="19" y1="5" x2="5" y2="19"></line>
			</svg>
		</button>
	</div>

	<nav class="mt-12 flex flex-col gap-9" aria-label="Mobile navigation">
		{
			t.nav.links.map((link) => (
				<a
					href={link.href}
					class="text-[15px] font-semibold uppercase tracking-[0.22em] text-ink transition-colors hover:text-accent"
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<div class="mt-10">
		<LangSwitch />
	</div>

	<a
		href="#contact"
		class="mt-12 block bg-accent py-3.5 text-center font-mono text-sm font-bold uppercase tracking-[0.18em] text-night transition-colors active:bg-ink"
	>
		{t.nav.cta}
	</a>
</div>

<style>
	/* El destello: se activa añadiendo la clase .flash desde JS.
	   forwards + una sola pasada = ocurre una vez y no se repite. */
	#nav-flash.flash {
		animation: sweep 1.1s ease-out forwards;
	}

	@keyframes sweep {
		from {
			transform: translateX(-100%);
		}
		to {
			/* el span mide 1/3 del ancho: 400% de sí mismo lo saca por la derecha */
			transform: translateX(400%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#nav-flash.flash {
			animation: none;
		}
	}
</style>

<script>
	/* ---------- Menú móvil ---------- */
	const openBtn = document.getElementById("menu-open");
	const closeBtn = document.getElementById("menu-close");
	const menu = document.getElementById("mobile-menu");

	if (openBtn && closeBtn && menu) {
		const setOpen = (open: boolean) => {
			menu.classList.toggle("hidden", !open);
			menu.classList.toggle("flex", open);
			openBtn.setAttribute("aria-expanded", String(open));
			document.body.classList.toggle("overflow-hidden", open);
		};

		openBtn.addEventListener("click", () => setOpen(true));
		closeBtn.addEventListener("click", () => setOpen(false));

		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") setOpen(false);
		});
	}

	/* ---------- Estados del navbar + destello de la línea ---------- */
	const header = document.getElementById("site-header");
	const navLine = document.getElementById("nav-line");
	const flash = document.getElementById("nav-flash");
	// El destello solo se "arma" si la página cargó arriba del todo: si el
	// navegador restaura una posición de scroll previa, no hay destello.
	let armed = window.scrollY === 0;

	const onScroll = () => {
		const scrolled = window.scrollY > 10;

		// Estado del fondo: transparente arriba, oscuro + blur al scrollear
		header?.classList.toggle("bg-night/85", scrolled);
		header?.classList.toggle("backdrop-blur-md", scrolled);
		navLine?.classList.toggle("opacity-0", !scrolled);

		if (armed && scrolled) {
			armed = false; // una única vez por carga de página
			flash?.classList.add("flash");
		}
	};

	onScroll(); // aplica el estado correcto también si la página carga scrolleada
	window.addEventListener("scroll", onScroll, { passive: true });
</script>
