---
import { getDict } from "../i18n";

const t = getDict(Astro.currentLocale);

// Bucle infinito: el track se desplaza -50% y reinicia, con 2 copias
// idénticas para que la segunda rellene el hueco sin costura.
// CLAVE: una copia debe ser MÁS ANCHA que el viewport, o aparece un
// vacío al final del recorrido — por eso repetimos la lista 4 veces
// dentro de cada copia (~3600px, cubre hasta ultrawide).
const items = Array.from({ length: 4 }, () => t.marquee).flat();
const copies = [0, 1];
---

<div class="marquee overflow-hidden border-b border-line py-3.5">
	<div class="track flex w-max items-center">
		{
			copies.map((copy) => (
				<div
					class="flex items-center gap-8 pr-8"
					aria-hidden={copy === 1 ? "true" : undefined}
				>
					{items.map((item) => (
						<Fragment>
							<span class="whitespace-nowrap font-mono text-xs uppercase tracking-[0.2em] text-ink-muted">
								{item}
							</span>
							<span class="text-xs text-accent">&#10022;</span>
						</Fragment>
					))}
				</div>
			))
		}
	</div>
</div>

<style>
	.track {
		/* el track mide 4× más que antes: duración ×4 = misma velocidad */
		animation: scroll 112s linear infinite;
	}

	/* Cortesía: pausa al pasar el cursor, se puede leer con calma */
	.marquee:hover .track {
		animation-play-state: paused;
	}

	@keyframes scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}
	}
</style>
