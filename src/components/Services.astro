---
import { getDict } from "../i18n";
import SectionHeading from "./ui/SectionHeading.astro";

const t = getDict(Astro.currentLocale);

// Iconos de trazo: stroke="currentColor" hereda el color del texto,
// así el group-hover los tiñe de lima sin CSS extra. Orden = orden
// de los servicios en el diccionario.
const icons = [
	// Web Design: retícula
	`<rect x="3" y="3" width="18" height="18"/><path d="M3 9h18M9 3v18"/>`,
	// Development: brackets de código
	`<path d="m8 7-5 5 5 5M16 7l5 5-5 5"/>`,
	// Digital Strategy: diana
	`<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/>`,
	// Performance: rayo
	`<path d="M13 2 3 14h7l-1 8 11-13h-7l0-7z"/>`,
];
---

<section id="services" class="scroll-mt-24 border-b border-line">
	<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28" data-reveal>
		<SectionHeading label={t.services.label} title={t.services.title} />

		<!-- Mismo truco hairline que en Stats: 1 col en móvil, 2x2 desde md -->
		<div
			class="mt-14 grid grid-cols-1 gap-px border border-line bg-line md:grid-cols-2"
		>
			{
				t.services.items.map((service, i) => (
					<article class="group bg-night p-7 transition-colors hover:bg-surface sm:p-9">
						<div class="flex items-start justify-between">
							<span class="font-mono text-xs text-ink-muted">
								{String(i + 1).padStart(2, "0")}
							</span>
							<svg
								class="h-5 w-5 text-ink-muted transition-colors group-hover:text-accent"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								set:html={icons[i]}
							/>
						</div>
						<h3 class="mt-8 font-headline text-xl font-bold uppercase transition-colors group-hover:text-accent sm:text-2xl">
							{service.title}
						</h3>
						<p class="mt-3 max-w-md text-sm leading-relaxed text-ink-muted">
							{service.description}
						</p>
						<div class="mt-7 flex flex-wrap gap-2">
							{service.tags.map((tag) => (
								<span class="border border-line px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.15em] text-ink-muted">
									{tag}
								</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
