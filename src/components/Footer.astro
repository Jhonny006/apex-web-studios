---
import { getDict } from "../i18n";

const t = getDict(Astro.currentLocale);

// El año se calcula en BUILD, no en el navegador: si el sitio se
// reconstruye en 2027, el copyright se actualiza solo. Cero JS.
const year = new Date().getFullYear();
---

<footer>
	<div
		class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 sm:px-8 md:flex-row md:items-center md:justify-between"
	>
		<a
			href="#"
			class="whitespace-nowrap font-bold text-sm uppercase tracking-[0.2em] transition-colors hover:text-accent"
		>
			Apex Web Studios
		</a>

		<p class="font-mono text-[11px] text-ink-muted">
			&copy; {year} Apex Web Studios. {t.footer.rights}
		</p>

		<div class="flex items-center gap-6">
			{
				t.footer.links.map((link) => (
					<a
						href="#"
						class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-muted transition-colors hover:text-accent"
					>
						{link}
					</a>
				))
			}
			<!-- href="#" sin id: comportamiento nativo de "volver arriba" -->
			<a
				href="#"
				aria-label="Back to top"
				class="border border-line px-3 py-2 font-mono text-xs text-ink-muted transition-colors hover:border-accent hover:text-accent"
			>
				&uarr;
			</a>
		</div>
	</div>
</footer>
