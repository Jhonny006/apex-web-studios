---
import { getDict } from "../i18n";
import SectionHeading from "./ui/SectionHeading.astro";

const t = getDict(Astro.currentLocale);
---

<section id="pricing" class="scroll-mt-24 border-b border-line">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28" data-reveal>
        <SectionHeading label={t.pricing.label} title={t.pricing.title} />
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-ink-muted">
            {t.pricing.intro}
        </p>

        <div
            class="mt-14 grid grid-cols-1 gap-px border border-line bg-line md:grid-cols-3"
        >
            {
                t.pricing.packages.map((pkg, i) => (
                    <article
                        class:list={[
                            "group flex flex-col bg-night p-7 transition-colors hover:bg-surface sm:p-9",
                            pkg.featured && "bg-surface",
                        ]}
                    >
                        <div class="flex items-start justify-between">
                            <span class="font-mono text-xs text-ink-muted">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            {pkg.featured && (
                                <span class="border border-accent px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.15em] text-accent">
                                    Popular
                                </span>
                            )}
                        </div>

                        <h3 class="mt-8 font-headline text-xl font-bold uppercase transition-colors group-hover:text-accent sm:text-2xl">
                            {pkg.name}
                        </h3>
                        <p class="mt-2 font-mono text-lg text-ink">
                            {pkg.price}
                        </p>
                        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
                            {pkg.description}
                        </p>

                        <ul class="mt-7 flex flex-1 flex-col gap-2.5">
                            {pkg.features.map((feature) => (
                                <li class="flex items-start gap-2 text-sm text-ink-muted">
                                    <svg
                                        class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                    {feature}
                                </li>
                            ))}
                        </ul>

                        <a
                            href="#contact"
                            class="mt-8 inline-block border border-line px-5 py-3 text-center font-mono text-xs uppercase tracking-[0.15em] transition-colors hover:border-accent hover:text-accent"
                        >
                            {pkg.cta}
                        </a>
                    </article>
                ))
            }
        </div>
    </div>
</section>
